  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "^4.19.2",
    "ping": "^0.4.4",
    "ssh2": "^1.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "drizzle-kit": "^1.0.0-rc.4",
    "eslint": "^9.39.5",
    "globals": "^17.8.0",
    "puppeteer": "^25.4.0"
  }
